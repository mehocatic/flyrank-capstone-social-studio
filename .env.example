# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_FILE=./data/studio.db
# Used to build clickable links to mock previews. Defaults to http://localhost:PORT
PUBLIC_BASE_URL=http://localhost:3000

# Platforms that `POST /posts/:id/generate` produces a variant for.
PLATFORMS=x,linkedin,discord

# Which adapter publishes each platform. Adapters: discord | mock_x | mock_linkedin
# Probe 6 (adapter swap by configuration only): change PUBLISHER_DISCORD to mock_x and restart.
PUBLISHER_X=mock_x
PUBLISHER_LINKEDIN=mock_linkedin
PUBLISHER_DISCORD=discord

# Your own Discord server: Server Settings > Integrations > Webhooks > Copy Webhook URL.
# Required only when an adapter named `discord` is in use. This is the one real secret
# here: it is never logged, never returned by an endpoint, and redacted out of any
# stored error message.
DISCORD_WEBHOOK_URL=

# Optional and not a secret. Only used to build a clickable link to a published
# message (https://discord.com/channels/GUILD/CHANNEL/MESSAGE). Right-click your
# server icon > Copy Server ID (needs Developer Mode on). Without it the publish
# history still records the message id.
DISCORD_GUILD_ID=

# Worker tuning. The lease must outlast PUBLISH_TIMEOUT_MS.
WORKER_POLL_MS=2000
WORKER_LEASE_MS=60000
PUBLISH_TIMEOUT_MS=10000
MAX_PUBLISH_ATTEMPTS=5
